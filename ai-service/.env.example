# File MAU - duoc commit. Chi ghi TEN bien, KHONG ghi gia tri bi mat.
# Gia tri that dat trong file .env (da nam trong .gitignore).

# Sinh khoa: python -c "import secrets; print(secrets.token_hex(32))"
# Dat cung gia tri o ca ai-service va backend NestJS. Toi thieu 32 ky tu.
INTERNAL_API_KEY=

# Token Hugging Face - can cho dataset gated FSRS-Anki-20k va tai trong so (repo private)
HF_TOKEN=
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Trong so mo hinh du bao quen
# hub = tai tu Hugging Face (production) ; default = DEFAULT_W (chi de test)
FSRS_WEIGHTS_SOURCE=hub
FSRS_WEIGHTS_REPO=Hieusss/wsea-fsrs-weights
FSRS_WEIGHTS_FILE=params.json
FSRS_WEIGHTS_REVISION=v1
FSRS_MAX_INTERVAL=36500

# Ket noi Postgres co pgvector (Supabase)
DATABASE_URL=

# LLM cho khau sinh cau tra loi cua tro ly
GEMINI_API_KEY=